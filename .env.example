# Copy to .env and fill in. Every value is optional, but with none of them set
# the bridge can only discover devices you have already enabled for LAN control,
# and it has nowhere to publish them.

# --- MQTT broker (the same one Home Assistant uses) ---
GOVEE_MQTT_HOST=
GOVEE_MQTT_PORT=1883
GOVEE_MQTT_USER=
GOVEE_MQTT_PASSWORD=

# --- Govee account ---
# Needed for room names, live status over AWS IoT, and Tap-to-Run scenes.
GOVEE_EMAIL=
GOVEE_PASSWORD=

# --- Govee Platform API key ---
# Needed for scenes, music modes, segment control and sensor readings.
# Request one from https://developer.govee.com/reference/apply-you-govee-api-key
GOVEE_API_KEY=

# --- Presentation ---
GOVEE_TEMPERATURE_SCALE=C

# --- LAN discovery (only needed if multicast does not work on your network) ---
# GOVEE_LAN_BROADCAST_ALL=true
# GOVEE_LAN_BROADCAST_GLOBAL=true
# GOVEE_LAN_SCAN=10.0.0.10,10.0.0.11
# GOVEE_LAN_NO_MULTICAST=true

# --- Bluetooth (see docs/BLE.md for what Docker needs) ---
# GOVEE_BLE=false
# GOVEE_BLE_ADAPTER=hci0
# GOVEE_BLE_PREFER=true
# GOVEE_BLE_ADDRESSES=2C:67:5C:E7:53:BC:97:9C=5C:E7:53:BC:97:9D
# GOVEE_BLE_PROFILE=H66A1=0d

# --- Logging: trace | debug | info | warn | error ---
GOVEE_LOG=info
